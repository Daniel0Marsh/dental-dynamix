# Django Configuration
SECRET_KEY=your_django_secret_key_here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Cloudflare Turnstile
# CLOUDFLARE_TURNSTILE_SITE_KEY=YOUR_SITE_KEY_HERE
# CLOUDFLARE_TURNSTILE_SECRET_KEY=YOUR_SECRET_KEY_HERE

# Cloudflare Turnstile Test Keys (for local development and testing)
CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_email_app_password
DEFAULT_FROM_EMAIL=your_from_email@domain.com

# Site Configuration
SITE_URL=https://yourdomain.com

# Bitcoin Tip Jar (Optional)
# Leave empty if you don't want to use the tip jar feature
BITCOIN_TIP_ADDRESS=your_bitcoin_address_here

# Calendly URLs (Optional)
# Replace with your actual URLs from Calendly dashboard
CALENDLY_QUICK_REVIEW_URL=https://calendly.com/your-username/quick-review
CALENDLY_FULL_SETUP_URL=https://calendly.com/your-username/full-setup
CALENDLY_ADVANCED_CONFIG_URL=https://calendly.com/your-username/advanced-config

# Production Database (Optional - for PostgreSQL)
# Uncomment and configure for production use
# DB_NAME=your_database_name
# DB_USER=your_database_user
# DB_PASSWORD=your_database_password
# DB_HOST=localhost
# DB_PORT=5432

# Instructions:
# 1. Copy this file to .env in the root folder: cp .env.example .env
# 2. Replace all placeholder values with your actual configuration
# 3. Never commit the .env file to version control
# 4. Keep this .env.example file updated with any new variables
