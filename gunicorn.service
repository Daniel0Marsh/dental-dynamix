[Unit]
Description=Gunicorn daemon for CodeBlock.io
After=network.target

[Service]
Type=simple
User=daniel
Group=daniel
WorkingDirectory=/home/daniel/codeblock-website-v3/source
Environment="PATH=/home/daniel/codeblock-website-v3/.venv/bin:/home/daniel/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/daniel/codeblock-website-v3/.venv/bin/gunicorn \
    core.wsgi:application \
    --bind unix:/run/gunicorn/codeblock.sock \
    --workers 3 \
    --timeout 120 \
    --keep-alive 2 \
    --max-requests 1000 \
    --max-requests-jitter 100 \
    --access-logfile /var/log/gunicorn/access.log \
    --error-logfile /var/log/gunicorn/error.log \
    --log-level info
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target 